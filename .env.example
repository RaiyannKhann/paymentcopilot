ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
PINECONE_API_KEY=
PINECONE_INDEX_NAME=payment-copilot-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATABASE_URL=postgresql://localhost/paymentcopilot
UC3_CONFIDENCE_THRESHOLD=0.45
UC1_CONFIDENCE_THRESHOLD=0.40
REDIS_URL=redis://localhost:6379/0
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.94
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_MAX_ENTRIES_PER_TENANT=50
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20
SESSION_TTL_SECONDS=1800
ENABLE_EVALS_ENDPOINT=false
CORS_ALLOW_ORIGINS=http://localhost:3000
TRACE_TTL_SECONDS=900
POSTGRES_USER=paymentcopilot
POSTGRES_PASSWORD=paymentcopilot
